---
import { getMediaItem } from "../../../content/get-media-items"
import Page from "../../../layouts/Page.astro"
import { markdownToText } from "../../../utils/markdown"
import { detailsPagePath } from "../../../utils/paths"

type Props = {
  mediaId: string
  /** Structured data to include in the page head as JSON-LD. */
  jsonLd?: Record<string, unknown>
}

const { mediaId: id, jsonLd } = Astro.props
const mediaItem = (await getMediaItem(id)).data
---

<Page
  title={mediaItem.title}
  description={markdownToText(mediaItem.description)}
  canonicalUrl={
    new URL(
      detailsPagePath(Astro.locals.i18n.defaultLocale, { id }),
      Astro.site,
    )
  }
>
  <Fragment slot="head">
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
      />
    )}
  </Fragment>
  <slot />
</Page>
