---
import { getImage } from "astro:assets"
import config from "virtual:lightnet/config"

import { getMediaItem } from "../../../content/get-media-items"
import Page from "../../../layouts/Page.astro"
import { markdownToText } from "../../../utils/markdown"
import { detailsPagePath } from "../../../utils/paths"
import { getDetailsPageJsonLd } from "../utils/get-details-page-json-ld"

type Props = {
  mediaId: string
  /** Schema.org type used when the media type does not specify one. */
  fallbackSchemaType?: string
}

const { mediaId: id, fallbackSchemaType = "CreativeWork" } = Astro.props
const { defaultLocale, currentLocale, tContentField, tConfigField } =
  Astro.locals.i18n
const mediaItem = (await getMediaItem(id)).data
const description = markdownToText(mediaItem.description)
const shareUrl = new URL(detailsPagePath(currentLocale, { id }), Astro.site)
const coverImage = config.disableOpenGraphImages
  ? await getImage({ src: mediaItem.image, format: "png" })
  : undefined
const shareImage = coverImage
  ? new URL(coverImage.src, Astro.site)
  : new URL(
      `${detailsPagePath(defaultLocale, { id })}open-graph.png`,
      Astro.site,
    )
const jsonLd = await getDetailsPageJsonLd({
  mediaId: id,
  fallbackSchemaType,
  site: Astro.site,
  defaultLocale,
  tContentField,
})
---

<Page
  title={mediaItem.title}
  description={description}
  canonicalUrl={new URL(detailsPagePath(defaultLocale, { id }), Astro.site)}
>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:title" content={mediaItem.title} />
    {description && <meta property="og:description" content={description} />}
    <meta
      property="og:site_name"
      content={tConfigField(config.title, config)}
    />
    <meta property="og:url" content={shareUrl.href} />
    <meta property="og:image" content={shareImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta
      property="og:image:width"
      content={String(coverImage ? mediaItem.image.width : 1200)}
    />
    <meta
      property="og:image:height"
      content={String(coverImage ? mediaItem.image.height : 630)}
    />
    <meta property="og:image:alt" content={mediaItem.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={mediaItem.title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={shareImage.href} />
    <meta name="twitter:image:alt" content={mediaItem.title} />
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
      />
    )}
  </Fragment>
  <slot />
</Page>
