---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import { cacheDir } from "astro:config/server"
import ArrowRightIcon from "lucide-react/icons/arrow-right"

import { getImageTint } from "../utils/get-image-tint"

interface Props {
  image: ImageMetadata
  id?: string
  title?: string
  text?: string
  link?: { href: string; text: string }
  className?: string
  titleClass?: string
  textClass?: string
}

const { image, id, title, text, link, className, titleClass, textClass } =
  Astro.props
let tint = "#e5e7eb"
try {
  tint = await getImageTint(image, new URL(cacheDir))
} catch (error) {
  console.warn("[lightnet] Cannot extract highlight image color:", error)
}
const tintChannels = tint.startsWith("rgb(")
  ? tint.slice(4, -1).split(",").map(Number)
  : [229, 231, 235]
const darkTint = (factor: number) =>
  `rgb(${tintChannels.map((channel) => Math.round(channel * factor)).join(",")})`
const iconDirectionClass =
  Astro.locals.i18n.direction === "rtl" ? "scale-x-[-1]" : ""
---

<section
  class="mt-24 w-full bg-[var(--image-tint)] text-gray-900 md:mt-28"
  class:list={[className]}
  id={id}
  style={{
    "--image-tint": tint,
    "--button-tint": darkTint(0.12),
    "--button-hover-tint": darkTint(0.08),
  }}
>
  <div class="flex flex-col overflow-hidden md:flex-row">
    <Image
      src={image}
      alt=""
      widths={[320, 640, 768, 1024, 1280, 2560]}
      sizes="(max-width: 768px) 100vw, 50vw"
      class="aspect-[4/3] w-full shrink-0 object-cover md:w-1/2 xl:aspect-video"
    />
    <div class="my-16 max-w-screen-sm px-4 md:px-8 lg:my-24 xl:px-16">
      {title && (
        <h2
          class="mb-4 text-balance text-2xl font-bold sm:mb-8 sm:text-3xl"
          class:list={titleClass}
        >
          {title}
        </h2>
      )}
      {text && (
        <p class="mb-10 text-lg sm:mb-12" class:list={textClass}>
          {text}
        </p>
      )}
      {link && (
        <a
          class="inline-flex items-center justify-center gap-2 rounded-2xl bg-[var(--button-tint)] px-6 py-3 text-sm font-bold text-gray-50 shadow-sm transition-colors hover:bg-[var(--button-hover-tint)] hover:text-gray-100"
          href={link.href}
        >
          {link.text}
          <ArrowRightIcon className={iconDirectionClass} />
        </a>
      )}
      <slot />
    </div>
  </div>
</section>

<style>
  section {
    background-image: linear-gradient(
      to bottom,
      rgb(255 255 255 / 25%),
      transparent
    );
  }
</style>
