---
import config from "virtual:lightnet/config"

import { ensureTrailingSlash } from "../../../utils/paths"

type Props = {
  disallowSearchIndexing?: boolean
  canonicalUrl?: URL
}

const { disallowSearchIndexing, canonicalUrl: canonicalUrlProp } = Astro.props
const searchIndexing = !(
  disallowSearchIndexing ?? config.disallowSearchIndexing
)

const canonicalUrl =
  canonicalUrlProp ??
  new URL(ensureTrailingSlash(Astro.url.pathname), Astro.site)
---

{!searchIndexing && <meta name="robots" content="noindex" />}

{searchIndexing && (
  <>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalUrl.href} />
  </>
)}
